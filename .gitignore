# Generated by configure / autogen.sh, all at the top level.
# These entries are anchored with a leading slash on purpose: an
# unanchored "config.h" also matches win32/config.h, which is a
# checked-in source file.
/Makefile
/config.h
/config.h.in
/config.log
/config.status
/configure
/configure~
/aclocal.m4
/autom4te.cache/
/litmus
/tests/httpd
/neon/src/Makefile

# The executable (Unix name; the .exe form is covered below).
/litmus-cli

# Build output.
*.o
*.a
*.exe
*~

# Test run output.
/debug.log
/child.log
/clog

# Local WebDAV server used by tests/wsgidav.sh.
/dav-venv/
/davroot/

# Second-opinion WebDAV server and the scratch directories the test
# scripts write.
/tests/godav/godav
/tests/godav/godav.exe
/godav-results/
/hyperfine-root/

# Scratch directory tests/harness.sh falls back to when mktemp is
# unavailable.
/harness-work.*
