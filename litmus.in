#!/bin/sh
# Copyright (c) 2001-2025 Joe Orton <https://github.com/notroj/litmus>

prefix=@prefix@
exec_prefix=@prefix@
bindir=@bindir@

TESTROOT=${TESTROOT-"@bindir@"}
TESTS=${TESTS-"@TESTS@"}

usage() {
    cat <<EOF
litmus: Usage: $0 [OPTIONS] URL [USERNAME PASSWORD]

Options:
 -k, --keep-going           continue testing even if one suite fails
 -p, --proxy=URL            use given proxy server URL
 -s, --system-proxy         use proxy server configuration from system
 -c, --client-cert=CERT     use given PKCS#12 client cert
 -u, --client-cert-uri=URI  use given client cert URI
 -i, --insecure             ignore TLS certificate verification failures
 -q, --quiet                use abbreviated output
 -n, --no-colour            disable colour in output
 -o, --colour               enable colour in output
 -j, --json                 write results to stdout as one JSON object
                            per suite, one per line
 -v, --verbose              write the protocol trace to stderr
 -t, --trace[=FILE]         dump every request and response to FILE
                            (default stderr; use - for stdout)

Significant environment variables:

    \$TESTS     - specify the suites to run
        default: "@TESTS@"
    \$TESTROOT  - directory holding litmus-cli
        default: @bindir@

This script runs each suite in turn through litmus-cli, which can also
run them itself:

    litmus-cli all URL [USERNAME PASSWORD]

Feedback via <https://github.com/Azathothas/litmus-windows>
EOF
    exit $1
}

nofail=0

case $1 in
--help|-h) usage 0 ;;
--keep-going|-k) nofail=1; shift ;;
--version) echo litmus @PACKAGE_VERSION@; exit 0 ;;
esac

test "$#" = "0" && usage 1

RV=0

CLI="${TESTROOT}/litmus-cli"
test -x "${CLI}" || CLI="${TESTROOT}/litmus-cli.exe"
if test ! -x "${CLI}"; then
    echo "ERROR: Could not find ${TESTROOT}/litmus-cli"
    exit 1
fi

for t in $TESTS; do
    if ${CLI} ${t} "$@"; then
        : pass
    elif test $nofail -eq 0; then
        echo "See debug.log for network/debug traces."
        exit 1
    else
        RV=1
    fi
done

exit $RV
