# litmus @configure_input@
SHELL = @SHELL@

# Installation directories
prefix = @prefix@
exec_prefix = @exec_prefix@
libexecdir = @libexecdir@
bindir = @bindir@
datadir = @datadir@
datarootdir = @datarootdir@

# Toolchain settings
CC = @CC@
CFLAGS = @CFLAGS@
CPPFLAGS = @DEFS@ @CPPFLAGS@ -I$(top_srcdir)/src -I$(top_srcdir)/$(TEST_COMMON)
PTHREAD_CC = @PTHREAD_CC@
PTHREAD_CFLAGS = @PTHREAD_CFLAGS@
PTHREAD_LIBS = @PTHREAD_LIBS@

LDFLAGS = @LDFLAGS@
LIBS = @NEON_LIBS@ @LIBS@
# expat may be in LIBOBJS, so must come after $(LIBS) (which has -lneon)
ALL_LIBS = -L. -ltest $(LIBS) $(LIBOBJS)

top_builddir = .
top_srcdir = @top_srcdir@
VPATH = @srcdir@
@SET_MAKE@

AR = @AR@
RANLIB = @RANLIB@
EXEEXT = @EXEEXT@

TEST_COMMON = @TEST_COMMON@
LIBOBJS = @LIBOBJS@
TESTOBJS = src/common.o $(TEST_COMMON)/tests.o
HDRS = src/common.h src/suites.h $(TEST_COMMON)/tests.h config.h

# Every suite is linked into one executable and selected by subcommand.
CLI_OBJS = src/litmus-cli.o src/basic.o src/copymove.o src/props.o \
	src/locks.o src/http.o src/largefile.o src/protected.o src/lockbomb.o
PROGRAM = litmus-cli$(EXEEXT)

TESTS = @TESTS@

URL = http://`hostname`/dav/
CREDS = `whoami` `whoami`
OPTS = 

INSTALL_PROGRAM = @INSTALL_PROGRAM@
INSTALL_DATA = @INSTALL_DATA@
INSTALL = @INSTALL@

# Fixme; use $(LIBOBJS) here instead. not happy on many non-GNU makes
# though; not sure why.
#
# subdirs is order-only: it is a phony target, so listing it as an
# ordinary prerequisite would make the executable out of date on every
# run and relink it every time.  Order-only keeps the neon build first
# without that, and makes -j safe here.  This needs GNU make, which
# both build paths already use.
ODEPS = libtest.a @LIBOBJS@ | subdirs

all: $(PROGRAM)
	@echo
	@echo "  Now run:"
	@echo ""
	@echo '     make URL=http://dav.server/path/ check'
	@echo ' or  make URL=http://dav.server/path/ CREDS="uname passwd" check'
	@echo ""

.PHONY: install check test-httpd test-wsgidav clean distclean subdirs

litmus: litmus.in
	@./config.status $@

check: $(PROGRAM) litmus
	@rm -f debug.log child.log
	@TESTROOT="$(top_builddir)" $(top_builddir)/litmus $(OPTS) $(URL) $(CREDS)

install: $(PROGRAM) litmus
	$(INSTALL) -d $(DESTDIR)$(bindir)
	$(INSTALL_PROGRAM) $(top_builddir)/litmus $(DESTDIR)$(bindir)/litmus
	$(INSTALL_PROGRAM) $(top_builddir)/$(PROGRAM) $(DESTDIR)$(bindir)/$(PROGRAM)

# lockbomb runs its workers as threads, so the whole executable is
# linked with the pthread flags.
$(PROGRAM): $(CLI_OBJS) $(ODEPS)
	$(PTHREAD_CC) $(PTHREAD_CFLAGS) $(LDFLAGS) -o $@ $(CLI_OBJS) \
	    $(PTHREAD_LIBS) $(ALL_LIBS)

subdirs:
	@cd neon/src && $(MAKE)

libtest.a: $(TESTOBJS)
	$(AR) cru $@ $(TESTOBJS)
	$(RANLIB) $@

clean:
	@cd neon/src && $(MAKE) clean
	rm -f */*.o $(TESTOBJS) $(CLI_OBJS) $(PROGRAM) libtest.a *~ debug.log child.log

distclean: clean
	@cd neon/src && $(MAKE) distclean
	rm -f Makefile litmus tests/httpd config.log config.h config.status

test-httpd: litmus $(PROGRAM)
	TESTROOT="$(top_builddir)" $(top_builddir)/tests/httpd $(OPTS)

# Runs the suites against a local wsgidav rather than an httpd
# container, so it works on Windows as well as Unix.  "make
# test-wsgidav OPTS=--check" compares the results against
# tests/expected-wsgidav.txt instead of just printing them.
test-wsgidav: $(PROGRAM)
	TESTROOT="$(top_builddir)" $(top_srcdir)/tests/wsgidav.sh $(OPTS)

.c.o:
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

Makefile: $(top_srcdir)/Makefile.in
	./config.status Makefile

src/litmus-cli.o: src/litmus-cli.c $(HDRS)
src/basic.o: src/basic.c $(HDRS)
src/common.o: src/common.c $(HDRS)
src/copymove.o: src/copymove.c $(HDRS)
src/locks.o: src/locks.c $(HDRS)
src/props.o: src/props.c $(HDRS)
src/http.o: src/http.c $(HDRS)
src/largefile.o: src/largefile.c $(HDRS)
src/protected.o: src/protected.c $(HDRS)
src/lockbomb.o: src/lockbomb.c $(HDRS)
	$(PTHREAD_CC) $(CPPFLAGS) $(PTHREAD_CFLAGS) $(CFLAGS) -c $< -o $@
